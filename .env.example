# Application
NODE_ENV=development
PORT=3000
# Public base URL of this API (used to build links, e.g. email verification).
APP_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=nestjs_starter
# TLS to the database. Optional in dev; MANDATORY in production (startup fails
# if NODE_ENV=production and this is not true). Set REJECT_UNAUTHORIZED=false
# only for a self-signed server certificate chain.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_LOGGING=false
# Auto-sync the schema from entities. Convenient in development; ALWAYS keep
# this false in production and use migrations instead (it is force-disabled
# when NODE_ENV=production regardless of this value).
DATABASE_SYNCHRONIZE=false
# Connection pool + timeouts (milliseconds).
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=10000

# Password hashing cost (bcrypt). Kept low in dev/test for speed; production is
# forced to a minimum of 10 by the config schema.
BCRYPT_ROUNDS=12

# Authentication — generate strong secrets, e.g. `openssl rand -base64 48`
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Issuer/audience claims, validated on every token verification.
JWT_ISSUER=nestjs-starter-kit
JWT_AUDIENCE=nestjs-starter-kit

# CORS — the single browser origin allowed to call the API with credentials
FRONTEND_URL=http://localhost:3001

# Express `trust proxy`. Set to match the real topology: 'false' (no proxy),
# a hop count like '1' (one load balancer/CDN in front), or a comma-separated
# list of trusted IPs/CIDRs. Over-trusting lets clients spoof X-Forwarded-For.
TRUST_PROXY=1

# Rate limiting — global bucket applied to every route (milliseconds + count).
# Auth endpoints add a stricter per-handler limit and per-account lockout.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Login lockout — after MAX_ATTEMPTS consecutive failures an account is locked
# for LOCKOUT_DURATION_MS (defence against online brute force).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MS=900000

# Email — disabled by default so the kit boots with no SMTP: the dev sender
# logs the message (including any verification link). Implement EmailSender and
# set EMAIL_ENABLED=true to wire a real provider.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@example.com
EMAIL_VERIFICATION_TOKEN_TTL_MS=86400000

# API docs (Swagger). Served at /docs. Force-disabled in production.
SWAGGER_ENABLED=true

# OAuth (optional) — leave the client id blank to disable a provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
